# Local settings for private, self-signed hmux builds.
#
# Copy this file to `.env-local` in the repository root and fill it in.
# `.env-local` is git-ignored: your Apple team, bundle IDs, signing identities,
# server paths and hostnames stay on your machine and never enter the repo.
#
# Read by:
#   scripts/build-local-only-mac.sh   Mac app for /Applications (Developer ID)
#   ios/scripts/build-local-only.sh   iPhone app (development profile, OTA)
#   scripts/publish-local-only-mac.sh notarized Mac DMG as a GitHub release
#
# Both build a "local-only" hmux: no hmux account, cloud, Iroh relays,
# presence, push, auto-update or telemetry. The iPhone pairs with the Mac
# over Tailscale using one-time local pairing codes.
#
# Values are plain shell assignments (KEY=value). Quote values with spaces.

# --- Identity ----------------------------------------------------------------

# Your Apple Developer team ID: 10 characters, shown under Membership in your
# developer account, or in parentheses after your certificate names in
#   security find-identity -v -p codesigning
HMUX_LOCAL_TEAM_ID=

# A reverse-DNS prefix you own, e.g. com.example. Bundle IDs default to
# <prefix>.hmux for the iPhone app and <prefix>.hmux.mac for the Mac app.
# Never use com.cmuxterm.* or dev.cmux.*: those belong to the official cmux apps.
HMUX_LOCAL_BUNDLE_PREFIX=

# Optional: override the derived bundle IDs.
#HMUX_LOCAL_IOS_BUNDLE_ID=
#HMUX_LOCAL_MAC_BUNDLE_ID=

# --- Mac app -----------------------------------------------------------------

# App name, shown in Finder, the Dock and Spotlight.
HMUX_LOCAL_MAC_APP_NAME="hmux"

# Developer ID Application identity: the full name, e.g.
#   "Developer ID Application: Your Name (TEAMID)"
# or its SHA-1 hash. Empty: the first Developer ID Application identity for
# HMUX_LOCAL_TEAM_ID in your keychain.
HMUX_LOCAL_MAC_SIGNING_IDENTITY=

# notarytool keychain profile used to notarize the Mac app. Create it once:
#   xcrun notarytool store-credentials <profile-name> \
#     --apple-id <you@example.com> --team-id <TEAMID> --password <app-specific-password>
# Empty: skip notarization. A locally built app still runs on this Mac, but
# Gatekeeper rejects it if you copy it to another one.
HMUX_LOCAL_NOTARY_PROFILE=

# App Store Connect API key, used to create (or reuse) the Mac app's Developer
# ID provisioning profile, which lets it keep secrets in its own Keychain group.
# Create a key under Users and Access > Integrations > App Store Connect API
# (role: Developer or higher). Empty: the app is signed without a Keychain
# group, and saved-session encryption and the CLI socket credential are lost.
HMUX_LOCAL_ASC_KEY_ID=
HMUX_LOCAL_ASC_ISSUER_ID=
HMUX_LOCAL_ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Where the finished Mac app is installed. Empty: leave it in the build folder.
HMUX_LOCAL_MAC_INSTALL_DIR=/Applications

# zig binary for the Ghostty CLI helper (theme picker, `ghostty +...`). Empty:
# the helper script looks in /opt/homebrew/bin, PATH and /usr/local/bin.
#HMUX_ZIG=

# GitHub repository (owner/name) that scripts/publish-local-only-mac.sh
# publishes releases to. A published app must be notarized, and the GPL
# requires that its recipients can get the matching source.
#HMUX_LOCAL_RELEASE_REPO=

# --- iPhone app --------------------------------------------------------------

# App name, shown on the Home Screen.
HMUX_LOCAL_IOS_APP_NAME="hmux"

# Development provisioning profile UUID covering the iPhone bundle ID (an
# exact App ID or your team wildcard) and your iPhone. Empty: the first
# matching profile on this Mac.
#HMUX_LOCAL_IOS_PROFILE=

# Over-the-air install: a folder your HTTPS web server publishes, and the
# public URL of that folder. iOS only installs over HTTPS. Empty: no OTA.
#HMUX_LOCAL_IOS_OTA_DIR=
#HMUX_LOCAL_IOS_OTA_URL=https://example.com/hmux

# Cable install: the iPhone's identifier from `xcrun devicectl list devices`.
#HMUX_IPHONE_DEVICE_ID=
