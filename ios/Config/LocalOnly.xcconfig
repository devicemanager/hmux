// LocalOnly.xcconfig
// A private build of the iPhone app that talks only to the owner's Macs over
// Tailscale, paired with `hmux://` codes. No hmux account, Iroh relays,
// presence, push, billing or telemetry. Built by ios/scripts/build-local-only.sh,
// which swaps this file in for Release.xcconfig on the app target.

#include "Release.xcconfig"

// Identity: the owner's App ID and team, never a hmux bundle. Both come
// from .env-local through the generated LocalOnly.signing.xcconfig below.
HMUX_APP_BUNDLE_IDENTIFIER = $(HMUX_LOCAL_ONLY_BUNDLE_IDENTIFIER)
PRODUCT_BUNDLE_IDENTIFIER = $(HMUX_APP_BUNDLE_IDENTIFIER)
HMUX_HOST_BUNDLE_IDENTIFIER = $(HMUX_APP_BUNDLE_IDENTIFIER)
DEVELOPMENT_TEAM = $(HMUX_LOCAL_ONLY_TEAM)
// Default name; ios/scripts/build-local-only.sh overrides it from
// HMUX_LOCAL_IOS_APP_NAME in .env-local.
PRODUCT_DISPLAY_NAME = hmux

// Read at runtime through CmxLocalOnlyMode.
HMUX_LOCAL_ONLY = YES
HMUX_LOCAL_PAIRING_URL_SCHEME = hmux

// Only the bundle's own Keychain group: no Sign in with Apple, push, app
// group or Network Extension.
HMUX_APP_CODE_SIGN_ENTITLEMENTS = Config/hmux-local-only.entitlements
CODE_SIGN_ENTITLEMENTS = $(HMUX_APP_CODE_SIGN_ENTITLEMENTS)

// No cloud origins are baked in. The app also forces its API origin to a
// closed loopback port at runtime.
HMUX_API_BASE_URL =
HMUX_IROH_BROKER_BASE_URL =
HMUX_IROH_V2_ENVIRONMENT =
HMUX_IROH_V2_BASE_URL =
HMUX_PRESENCE_BASE_URL =
HMUX_CRASH_REPORTING_ENABLED = NO

// Bundle id and team overrides from ios/scripts/build-local-only.sh
// (git-ignored). The script signs the built app itself.
#include? "LocalOnly.signing.xcconfig"
