// Release.xcconfig
// Release configuration for iOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"

HMUX_APP_BUNDLE_IDENTIFIER = dev.hmux.app.beta
PRODUCT_BUNDLE_IDENTIFIER = $(HMUX_APP_BUNDLE_IDENTIFIER)
// Manual Release archives default to BETA's registered notification extension.
// Distribution scripts override both host and extension identifiers for other lanes.
HMUX_HOST_BUNDLE_IDENTIFIER = $(HMUX_APP_BUNDLE_IDENTIFIER)
HMUX_NOTIFICATION_SERVICE_BUNDLE_IDENTIFIER = dev.hmux.app.beta.NotificationServiceV2
DEVELOPMENT_TEAM = 7WLXT3NR37

// Release/TestFlight/App Store artifacts always use production authorities.
// Keep these defaults in the configuration as a second line of defense behind
// the archive scripts, so a new Release workflow cannot inherit staging from a
// runner environment or a tagged development build.
HMUX_IOS_AUTH_ENV = production
HMUX_API_BASE_URL = https://cmux.com
HMUX_IROH_BROKER_BASE_URL = https://cmux.com
HMUX_PRESENCE_BASE_URL = https://presence.cmux.dev
HMUX_DEV_TAG =

// Distinguish the TestFlight beta on-device from a future App Store "hmux"
// (overrides PRODUCT_DISPLAY_NAME = hmux from Shared.xcconfig). Debug stays "hmux".
PRODUCT_DISPLAY_NAME = hmux BETA

// TestFlight/App Store builds use production APNs. Debug keeps
// Config/hmux.entitlements from Shared.xcconfig.
HMUX_APP_CODE_SIGN_ENTITLEMENTS = Config/hmux-release.entitlements
CODE_SIGN_ENTITLEMENTS = $(HMUX_APP_CODE_SIGN_ENTITLEMENTS)
