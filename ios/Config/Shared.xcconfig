// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = hmux
PRODUCT_DISPLAY_NAME = hmux
HMUX_APP_BUNDLE_IDENTIFIER = dev.hmux.ios
PRODUCT_BUNDLE_IDENTIFIER = $(HMUX_APP_BUNDLE_IDENTIFIER)
// The app whose extensions these are. Extension targets derive their ids from
// it; the app reads the Cloud VPN provider's id from its Info.plist.
HMUX_HOST_BUNDLE_IDENTIFIER = $(HMUX_APP_BUNDLE_IDENTIFIER)
HMUX_NOTIFICATION_SERVICE_BUNDLE_IDENTIFIER = $(HMUX_HOST_BUNDLE_IDENTIFIER).NotificationService
HMUX_CLOUD_VPN_BUNDLE_IDENTIFIER = $(HMUX_HOST_BUNDLE_IDENTIFIER).CloudVPN
HMUX_CLOUD_VPN_PROVIDER_BUNDLE_IDENTIFIER = $(HMUX_CLOUD_VPN_BUNDLE_IDENTIFIER)
// User-visible versions (CFBundleShortVersionString). Keep beta and production
// independent: TestFlight can stay on the already-approved beta version while
// the first production App Store upload starts from its own release version.
// Semver X.Y.Z; CFBundleVersion (CURRENT_PROJECT_VERSION) is the monotonic build
// id stamped by ios/scripts/upload-testflight.sh on upload.
HMUX_IOS_BETA_MARKETING_VERSION = 1.0.6
HMUX_IOS_APPSTORE_MARKETING_VERSION = 1.0.0
MARKETING_VERSION = $(HMUX_IOS_BETA_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = 5

// Dev-build identity, surfaced in-app (Settings > About) so a DEBUG dogfood
// build is tellable. Empty by default, so release/TestFlight builds show a clean
// "1.0.0". ios/scripts/reload.sh overrides these on the xcodebuild command line
// with the short git SHA and the --tag, and Config/Info.plist maps them to the
// HMUXGitSHA / HMUXDevTag Info.plist keys that AppVersionInfo reads.
HMUX_GIT_SHA =
HMUX_DEV_TAG =
// App Store archives set this marker on the host Info.plist. Reused archives
// must carry the marker before the VPN-free lane will strip and export them.
HMUX_APPSTORE_BUILD =

// Per-developer presence/paired-Mac-backup worker override, baked into the
// HMUXPresenceBaseURL Info.plist key so a normally-tapped dev device build (which
// sees no shell env) talks to an isolated worker instead of the shared
// hmux-presence-dev. Empty by default (release/TestFlight resolve to nil/disabled
// or the Debug default). ios/scripts/reload.sh overrides it from
// $HMUX_PRESENCE_BASE_URL. See workers/presence/scripts/deploy-dev.sh and
// PresenceServiceConfiguration.resolvedServiceBaseURL.
HMUX_PRESENCE_BASE_URL =

// Auth-environment override, baked into the HMUXAuthEnvironment Info.plist key
// so a normally-tapped dev device build (no shell env) can sign in against the
// PRODUCTION Stack project when testing production-account behavior. Empty by
// default (DEBUG -> development, Release -> production).
// ios/scripts/reload.sh --prod-auth sets it to "production". Keep the Info.plist
// key name in sync with
// MobileAuthComposition.authEnvironmentInfoPlistKey.
HMUX_IOS_AUTH_ENV =

// Tagged reloads bake the matching macOS tag's isolated web origin here.
// Empty normal builds retain AuthConfig's channel default.
HMUX_API_BASE_URL =

// Iroh trust-broker origin, independent of the general app API. Tagged dev
// reloads bake shared staging here so parallel Mac/iOS lanes can discover one
// another without moving their local feature APIs. Empty release builds fall
// back to AuthConfig's production API origin.
HMUX_IROH_BROKER_BASE_URL =

// IROH v2 control Worker. This is separate from the legacy broker key above
// so old compatibility routes cannot silently select the v2 backend.
HMUX_IROH_V2_ENVIRONMENT =
HMUX_IROH_V2_BASE_URL =
HMUX_IROH_V2_FORCE_RELAY = 0

// Crash reporting stays enabled for development and TestFlight. The official
// App Store lane overrides this to NO until its consent lifecycle is proven.
HMUX_CRASH_REPORTING_ENABLED = YES

// ==========================================
// Platform Configuration
// ==========================================
// Keep the app and all iOS Swift packages on the same iOS 18 floor.
// Embedded framework minimum versions are reconciled during the TestFlight
// export in ios/scripts/upload-testflight.sh.
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
INFOPLIST_KEY_NSCameraUsageDescription = Scan hmux pairing QR codes from your Mac terminal.

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/hmux.entitlements to add capabilities.
// Keep the app and notification-extension selectors separate so tagged Debug
// device signing can omit an unsupported capability without changing simulator
// or Release/TestFlight defaults.
HMUX_APP_CODE_SIGN_ENTITLEMENTS = Config/hmux.entitlements
HMUX_NOTIFICATION_SERVICE_CODE_SIGN_ENTITLEMENTS = Config/NotificationService.entitlements
HMUX_CLOUD_VPN_CODE_SIGN_ENTITLEMENTS = Config/CloudVPN.entitlements
CODE_SIGN_ENTITLEMENTS = $(HMUX_APP_CODE_SIGN_ENTITLEMENTS)

// ==========================================
// Pairing URL scheme (exact bundle)
// ==========================================
// Every bundle registers only its full-bundle-derived scheme.
HMUX_IOS_URL_SCHEME = hmux-ios-$(PRODUCT_BUNDLE_IDENTIFIER)

// ==========================================
// Local-only builds (Config/LocalOnly.xcconfig)
// ==========================================
// Normal builds keep accounts and register no extra scheme.
HMUX_LOCAL_ONLY = NO
HMUX_LOCAL_PAIRING_URL_SCHEME = $(HMUX_IOS_URL_SCHEME)
