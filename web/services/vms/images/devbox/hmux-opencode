#!/bin/bash
# OpenCode launcher (/usr/local/bin/opencode). Every entrypoint, including
# exec and direct process spawn, resolves this machine's sign-in mode
# (/etc/hmux/agent-auth.sh) before starting the pinned executable: team mode
# layers the CodeRouter providers on the user's configuration for this launch
# (OPENCODE_CONFIG), own mode adds none and drops the model-plane env, so
# `opencode auth login` credentials are used and never sent to CodeRouter.
# `cr use own|team` switches it; a switch applies to the next launch. No
# errexit: a HOME the config generators cannot write must still start opencode.
if [ "$#" -eq 1 ]; then
  case "$1" in --version|-v|--help|-h) exec /usr/local/libexec/hmux-opencode-real "$@" ;; esac
fi
. /etc/hmux/agent-config.sh
. /etc/hmux/agent-auth.sh
hmux_opencode_apply_auth_mode
if [ "$hmux_agent_auth_mode" = team ]; then
  hmux_ensure_opencode_config || exit $?
  # A configuration the caller pointed OPENCODE_CONFIG at wins.
  if [ -z "${OPENCODE_CONFIG-}" ] && [ -f "$HOME/.config/hmux/opencode-team.json" ]; then
    OPENCODE_CONFIG="$HOME/.config/hmux/opencode-team.json"
    export OPENCODE_CONFIG
  fi
fi
hmux_write_cua_mcp_config allow-missing
exec /usr/local/libexec/hmux-opencode-real "$@"
